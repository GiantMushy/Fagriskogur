---
const emails = ['fagriskogur@gmail.com', 'bjarnith@live.com', 'stokgulrot@gmail.com'];
const location = ['Grímsnes – og Grafningshreppur', '805 – Iceland', 'Hafnafjörður, 220 Iceland'];
---

<footer class="bg-dark">
	<div class="container section columns">
		<div>
			<h2>Contact Us</h2>
			<p>{emails.map((email) => <><a href={`mailto:${email}`}>{email}</a><br /></>)}</p>
		</div>
		<div>
			<h2>Location</h2>
			<p>{location.map((line) => <>{line}<br /></>)}</p>
		</div>
	</div>
	<div class="copyright">
		<p>© {new Date().getFullYear()} Fagriskogur. All rights reserved</p>
	</div>
</footer>

<style>
	footer {
		font-family: var(--sans);
	}

	.columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 72px;
	}

	@media (max-width: 569px) {
		.columns {
			grid-template-columns: 1fr;
			gap: 36px;
		}
	}

	h2 {
		margin-bottom: 18px;
		font-size: 24px;
		font-weight: 400;
		line-height: 1.5;
	}

	p {
		font-size: 18px;
		line-height: 1.75;
	}

	a:hover {
		opacity: 0.7;
	}

	.copyright {
		padding: 36px var(--gutter);
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		text-align: center;
	}

	.copyright p {
		font-size: 13px;
	}
</style>
