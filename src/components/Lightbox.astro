---
// Full-screen photo viewer, opened by the [data-photo] buttons in PhotoRows. The photos sit in a
// horizontal scroll-snap strip, so swiping works natively on phones; the arrow buttons and the
// arrow keys step through them on desktop, and Esc closes.
import { Image } from 'astro:assets';
import { upload, type Photo } from '../lib/site';

interface Props {
	photos: Photo[];
	alt: string;
}

const { photos, alt } = Astro.props;
---

{
	photos.length > 0 && (
		<dialog class="lightbox" aria-label="Photos">
			<ul class="strip">
				{photos.map((photo) => (
					<li>
						<figure>
							<Image
								src={upload(photo.src)}
								alt={photo.caption ? `${alt}: ${photo.caption}` : alt}
								widths={[1080, 1600, 2400]}
								sizes="100vw"
								layout="none"
								loading="lazy"
							/>
							{photo.caption && <figcaption>{photo.caption}</figcaption>}
						</figure>
					</li>
				))}
			</ul>
			<p class="count" aria-live="polite"></p>
			<button class="close" type="button" aria-label="Close">
				<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
					<path d="M5 5l14 14M19 5L5 19" />
				</svg>
			</button>
			{photos.length > 1 && (
				<>
					<button class="step prev" type="button" aria-label="Previous photo">
						<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
							<path d="M15 4l-8 8 8 8" />
						</svg>
					</button>
					<button class="step next" type="button" aria-label="Next photo">
						<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
							<path d="M9 4l8 8-8 8" />
						</svg>
					</button>
				</>
			)}
		</dialog>
	)
}

<script>
	const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
	if (dialog) {
		const strip = dialog.querySelector<HTMLElement>('.strip')!;
		const count = dialog.querySelector<HTMLElement>('.count')!;
		const total = strip.children.length;
		const current = () => Math.round(strip.scrollLeft / strip.clientWidth);
		const label = (index = current()) => {
			count.textContent = total > 1 ? `${index + 1} / ${total}` : '';
		};
		const go = (index: number, behavior: ScrollBehavior = 'smooth') => {
			const clamped = Math.max(0, Math.min(total - 1, index));
			strip.scrollTo({ left: clamped * strip.clientWidth, behavior });
			label(clamped);
		};

		for (const button of document.querySelectorAll<HTMLElement>('[data-photo]')) {
			button.addEventListener('click', () => {
				// The big versions only download once someone opens the viewer. (Lazy loading alone
				// never fires for them: the strip starts hidden and the images have no size yet.)
				for (const img of strip.querySelectorAll('img')) img.loading = 'eager';
				dialog.showModal();
				go(Number(button.dataset.photo), 'instant');
			});
		}
		// Swiping moves the strip without going through go().
		strip.addEventListener('scroll', () => label(), { passive: true });
		dialog.querySelector('.close')!.addEventListener('click', () => dialog.close());
		dialog.querySelector('.prev')?.addEventListener('click', () => go(current() - 1));
		dialog.querySelector('.next')?.addEventListener('click', () => go(current() + 1));
		dialog.addEventListener('keydown', (event) => {
			const step = event.key === 'ArrowLeft' ? -1 : event.key === 'ArrowRight' ? 1 : 0;
			if (!step) return;
			event.preventDefault();
			go(current() + step);
		});
		// Clicking the dark space around a photo closes the viewer.
		dialog.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).matches('li, figure')) dialog.close();
		});
	}
</script>

<style>
	.lightbox {
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: #111213;
		color: #fff;
		overflow: hidden;
	}

	.lightbox::backdrop {
		background: transparent;
	}

	:global(html:has(.lightbox[open])) {
		overflow: hidden;
	}

	.strip {
		display: flex;
		height: 100%;
		margin: 0;
		padding: 0;
		list-style: none;
		overflow-x: auto;
		overscroll-behavior: contain;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.strip::-webkit-scrollbar {
		display: none;
	}

	li {
		display: grid;
		flex: 0 0 100%;
		place-items: center;
		padding: 72px 96px;
		scroll-snap-align: center;
		scroll-snap-stop: always;
	}

	figure {
		display: grid;
		justify-items: center;
		gap: 16px;
		margin: 0;
	}

	img {
		width: auto;
		height: auto;
		max-width: 100%;
		max-height: calc(100dvh - 180px);
		object-fit: contain;
	}

	figcaption,
	.count {
		font-family: var(--sans);
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.75);
	}

	.count {
		position: absolute;
		top: 28px;
		left: 32px;
	}

	button {
		position: absolute;
		display: grid;
		place-items: center;
		width: 48px;
		height: 48px;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		color: #fff;
		cursor: pointer;
		transition: background-color 0.2s;
	}

	button:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.close {
		top: 16px;
		right: 16px;
	}

	.step {
		top: 50%;
		transform: translateY(-50%);
	}

	.prev {
		left: 24px;
	}

	.next {
		right: 24px;
	}

	@media (max-width: 959px) {
		li {
			padding: 64px 16px;
		}
	}

	/* On touch screens you swipe instead. */
	@media (hover: none) {
		.step {
			display: none;
		}
	}
</style>
