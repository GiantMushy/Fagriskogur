---
import { FACEBOOK_URL, href } from '../lib/site';

interface Props {
	/** Starts transparent over the hero and turns white once the page scrolls (homepage and room pages). */
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { overlay }]} data-overlay={overlay ? '' : undefined}>
	<a class="logo" href={href('/')} aria-label="Fagriskógur Lodge – home">
		<svg viewBox="0 0 32 32" width="36" height="36" aria-hidden="true">
			<path d="M4 16 16 6l12 10M7 13.5V27h18V13.5M13.5 27v-7h5v7" />
		</svg>
	</a>
	<nav aria-label="Main">
		{
			FACEBOOK_URL && (
				<a class="menu-link" href={FACEBOOK_URL} aria-label="Facebook">
					<svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
						<path
							fill="currentColor"
							d="M24 12a12 12 0 1 0-13.9 11.9v-8.4h-3V12h3V9.4c0-3 1.8-4.7 4.5-4.7 1.3 0 2.7.2 2.7.2v2.9h-1.5c-1.5 0-2 .9-2 1.9V12h3.4l-.5 3.5h-2.9v8.4A12 12 0 0 0 24 12z"
						/>
					</svg>
				</a>
			)
		}
		<a class="button" href="#contact">Plan your stay</a>
	</nav>
</header>

{
	overlay && (
		<script>
			const header = document.querySelector<HTMLElement>('.site-header[data-overlay]')!;
			const update = () => header.classList.toggle('is-scrolled', scrollY > 10);
			addEventListener('scroll', update, { passive: true });
			update();
		</script>
	)
}

<style>
	.site-header {
		position: relative;
		z-index: 40;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: var(--header-h);
		padding-inline: var(--gutter);
		background: #fff;
		border-bottom: 1px solid var(--border);
	}

	.overlay {
		position: fixed;
		inset: 0 0 auto;
		background: transparent;
		border-bottom-color: rgba(255, 255, 255, 0.2);
		transition:
			background-color 0.3s,
			box-shadow 0.3s,
			border-color 0.3s;
	}

	.overlay.is-scrolled {
		background: #fff;
		border-bottom-color: transparent;
		box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
	}

	/* Thin line-art house, drawn in the text colour so it turns white over the hero. */
	.logo {
		display: flex;
		color: var(--heading);
		transition:
			color 0.3s,
			opacity 0.2s;
	}

	.logo:hover {
		opacity: 0.6;
	}

	.logo svg {
		fill: none;
		stroke: currentColor;
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.overlay:not(.is-scrolled) .logo {
		color: #fff;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 36px;
	}

	.button {
		padding: 12px 20px;
		color: var(--heading);
	}

	.button:hover {
		color: #fff;
	}

	.overlay:not(.is-scrolled) .button {
		color: #fff;
	}

	.overlay:not(.is-scrolled) .button:hover {
		border-color: #fff;
		background: #fff;
		color: var(--dark);
	}

	@media (max-width: 569px) {
		.button {
			padding: 10px 14px;
			font-size: 11px;
		}
	}

	.menu-link {
		display: flex;
		color: rgba(48, 49, 51, 0.5);
		transition: color 0.2s;
	}

	.menu-link:hover {
		color: var(--heading);
	}

	.overlay:not(.is-scrolled) .menu-link {
		color: rgba(255, 255, 255, 0.5);
	}

	.overlay:not(.is-scrolled) .menu-link:hover {
		color: #fff;
	}
</style>
