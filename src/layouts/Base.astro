---
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/600.css';
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, upload } from '../lib/site';

interface Props {
	title: string;
	description?: string;
	/** Transparent header over a full-screen hero (homepage). */
	overlayHeader?: boolean;
}

const {
	title,
	description = 'Fagriskógur Lodge – a luxury family retreat in the Golden Circle, Iceland.',
	overlayHeader = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = await getImage({ src: upload('2024/12/1Bakvid_Mars2024-scaled.jpg'), width: 1200, format: 'jpg' });
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href={href('/favicon-32.webp')} sizes="32x32" />
		<link rel="icon" href={href('/icon-192.webp')} sizes="192x192" />
		<link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={new URL(ogImage.src, Astro.site)} />
		<meta name="generator" content={Astro.generator} />
	</head>
	<body>
		<Header overlay={overlayHeader} />
		<main>
			<slot />
		</main>
		<Footer />
		<a class="to-top" href="#" aria-label="Back to top">
			<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2 8l4-4 4 4" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
		</a>
		<script>
			const toTop = document.querySelector<HTMLElement>('.to-top')!;
			const update = () => toTop.classList.toggle('is-visible', scrollY > 400);
			addEventListener('scroll', update, { passive: true });
			update();
		</script>
	</body>
</html>

<style>
	.to-top {
		position: fixed;
		right: 18px;
		bottom: 18px;
		z-index: 50;
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		border-radius: 2px;
		background: var(--dark);
		color: #fff;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s;
	}
	.to-top.is-visible {
		opacity: 1;
		pointer-events: auto;
	}
</style>
