---
// Uncode "media stack": three overlapping square photos. The back-left and front
// photos drift at different speeds while scrolling (Uncode's parallax).
import { Image } from 'astro:assets';
import { upload } from '../lib/site';

interface Props {
	backRight: string;
	backLeft: string;
	front: string;
}

const { backRight, backLeft, front } = Astro.props;
const shared = { alt: '', widths: [390, 600, 780], sizes: '(max-width: 959px) 65vw, 390px', layout: 'none' } as const;
---

<div class="collage">
	<Image class="back-right" src={upload(backRight)} {...shared} />
	<Image class="back-left" src={upload(backLeft)} {...shared} />
	<Image class="front" src={upload(front)} {...shared} />
</div>

<style>
	/* Geometry measured on the live site: 390px squares in a 600 × 573 column. */
	.collage {
		position: relative;
		aspect-ratio: 600 / 573;
	}

	.collage :global(img) {
		position: absolute;
		width: 65%;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.back-right {
		left: 28.8%;
		top: 13.8%;
	}

	.back-left {
		left: 6%;
		top: 0;
		z-index: 1;
	}

	.front {
		left: 17.5%;
		top: 32.1%;
		z-index: 2;
	}

	@supports (animation-timeline: view()) {
		.back-left,
		.front {
			animation: drift linear both;
			animation-timeline: view();
		}
		.back-left {
			--drift: 20px;
		}
		.front {
			--drift: 40px;
		}
	}

	@keyframes drift {
		from {
			transform: translateY(var(--drift));
		}
		to {
			transform: translateY(calc(-1 * var(--drift)));
		}
	}
</style>
