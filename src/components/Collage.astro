---
// Uncode "media stack": three overlapping square photos. While scrolling, the back-left
// photo drifts at Rellax speed 1 and the front one at speed 2, as on the old site.
import { Image } from 'astro:assets';
import { upload } from '../lib/site';

interface Props {
	backRight: string;
	backLeft: string;
	front: string;
}

const { backRight, backLeft, front } = Astro.props;
const shared = { alt: '', widths: [390, 600, 780], sizes: '(max-width: 959px) 65vw, 390px', layout: 'none' } as const;
---

<div class="collage">
	<Image class="back-right" src={upload(backRight)} {...shared} />
	<Image class="back-left" src={upload(backLeft)} data-parallax="1" {...shared} />
	<Image class="front" src={upload(front)} data-parallax="2" {...shared} />
</div>

<script>
	import '../scripts/parallax';
</script>

<style>
	/* Geometry measured on the live site: 390px squares in a 600 × 573 column. */
	.collage {
		position: relative;
		aspect-ratio: 600 / 573;
	}

	.collage :global(img) {
		position: absolute;
		width: 65%;
		aspect-ratio: 1;
		object-fit: cover;
	}

	.back-right {
		left: 28.8%;
		top: 13.8%;
	}

	.back-left {
		left: 6%;
		top: 0;
		z-index: 1;
	}

	.front {
		left: 17.5%;
		top: 32.1%;
		z-index: 2;
	}
</style>
