---
// Contact block on every page. The header's "Plan your stay" button links here.
import { CONTACT_EMAIL } from '../lib/site';
---

<footer class="bg-dark" id="contact">
	<div class="container section contact">
		<p class="eyebrow">Contact Us</p>
		<h2>Plan your stay</h2>
		<p class="lead">Get in touch to check dates and arrange your visit.</p>
		<a class="button" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
	</div>
	<div class="copyright">
		<p>© {new Date().getFullYear()} Fagriskogur. All rights reserved</p>
	</div>
</footer>

<style>
	footer {
		font-family: var(--sans);
	}

	.contact {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.eyebrow {
		color: rgba(255, 255, 255, 0.6);
	}

	h2 {
		margin-top: 24px;
		font-family: var(--serif);
		font-size: 50px;
		font-weight: 400;
		line-height: 1.2;
	}

	.lead {
		margin-top: 18px;
		font-size: 18px;
		color: rgba(255, 255, 255, 0.75);
	}

	.button {
		margin-top: 36px;
		text-transform: none;
		letter-spacing: 0.08em;
		font-size: 15px;
	}

	@media (max-width: 959px) {
		h2 {
			font-size: 33.33px;
		}
	}

	.copyright {
		padding: 36px var(--gutter);
		border-top: 1px solid rgba(255, 255, 255, 0.07);
		text-align: center;
	}

	.copyright p {
		font-size: 13px;
		color: rgba(255, 255, 255, 0.6);
	}
</style>
